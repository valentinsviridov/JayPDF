{
  "name": "jaypdf",
  "version": "1.0.0",
  "description": "Privacy-first client-side PDF toolkit running 100% in the browser.",
  "keywords": [
    "pdf",
    "pdf-tools",
    "privacy",
    "client-side",
    "nextjs",
    "react",
    "pdf-lib"
  ],
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "cross-env STRICT_LINT=true next dev --turbo",
    "lint": "cross-env STRICT_LINT=true eslint .",
    "lint:fix": "cross-env STRICT_LINT=true eslint --fix .",
    "preview": "bun run build && bunx serve out --single",
    "start": "bunx serve out --single",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test",
    "setup-worker": "bun scripts/setup-pdf-worker.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "baseline-browser-mapping": "^2.11.12",
    "caniuse-lite": "^1.0.30001809",
    "geist": "^1.7.2",
    "lucide-react": "^0.563.0",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint": "^8.56.12",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react": "^7.37.5",
    "jszip": "^3.10.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
