{
  "name": "jaypdf",
  "version": "1.0.0",
  "description": "Privacy-first client-side PDF toolkit running 100% in the browser.",
  "keywords": [
    "pdf",
    "pdf-tools",
    "privacy",
    "client-side",
    "nextjs",
    "react",
    "pdf-lib"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git@github.com:valentinsviridov/JayPDF.git"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun run setup-worker && bun scripts/generate-notices.mjs && next build --webpack",
    "android:prepare": "bun run build && bun scripts/prepare-android.mjs",
    "android:debug": "bun run android:prepare && cd android && ./gradlew assembleDebug",
    "android:bundle": "bun run android:prepare && cd android && ./gradlew bundleRelease",
    "android:check": "bun scripts/check-android.mjs",
    "android:test-web": "playwright test --config=playwright.android.config.ts",
    "dev": "bun run setup-worker && cross-env STRICT_LINT=true next dev --turbo",
    "lint": "cross-env STRICT_LINT=true eslint .",
    "lint:fix": "cross-env STRICT_LINT=true eslint --fix .",
    "preview": "bun run build && bunx serve out --single",
    "start": "bunx serve out --single",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test",
    "test:save": "playwright test --config=playwright.save.config.ts",
    "setup-worker": "bun scripts/setup-pdf-worker.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "baseline-browser-mapping": "^2.11.28",
    "caniuse-lite": "^1.0.30001815",
    "geist": "^1.7.2",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-react": "^7.37.5",
    "jszip": "^3.10.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
